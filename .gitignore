# ── Datos privados del usuario: nunca se versionan ──────────────────────────
/cv.md
/config/profile.yml
/portals.yml
/.env
/.env.*
!/.env.example
/data/*
!/data/.gitkeep

# Ofertas extraídas, evaluaciones y CVs generados
/jds/*
!/jds/.gitkeep
/reports/*
!/reports/.gitkeep
/output/*
!/output/.gitkeep

# Estado local del escáner y del render
/data/cache/
data/*.tsv
pdf-index.tsv
*.bak

# ── Node ────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Editores y sistema ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# ── Agentes / CLI ───────────────────────────────────────────────────────────
.opencode/*
!/.opencode/commands/
!/.opencode/commands/career-ops.md
.claude/settings.local.json
CLAUDE.local.md

# ── Generados ───────────────────────────────────────────────────────────────
*.overflow.pdf
coverage/
.tmp/
