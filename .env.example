# career-ops-lite — variables opcionales
#
# Copia este fichero a `.env` solo si necesitas cambiar algún valor.
# Todos los valores por defecto funcionan sin `.env`.

# ── Extractor de ofertas (extract-jd.mjs) ───────────────────────────────────

# Navegador a usar: chromium (por defecto) o firefox.
CAREER_OPS_BROWSER=chromium

# Perfil persistente de navegador. Actívalo solo si un portal exige sesión
# iniciada (LinkedIn, Indeed, Glassdoor...). Es el directorio donde el
# navegador guarda cookies y sesión: la primera vez abre en modo visible,
# inicia sesión a mano, cierra, y a partir de ahí reutiliza esa sesión.
#
#   CAREER_OPS_BROWSER_PROFILE=~/.cache/career-ops/browser-profile
#
# Sin valor: navegador limpio y anónimo en cada ejecución (recomendado).
CAREER_OPS_BROWSER_PROFILE=

# 1 = sin ventana (por defecto). 0 = navegador visible, útil para depurar o
# para iniciar sesión en el perfil persistente.
CAREER_OPS_HEADLESS=1

# Tamaño máximo del texto extraído, en caracteres. Más texto = más contexto,
# más tokens. 8000 cubre una oferta larga sin arrastrar el menú del portal.
CAREER_OPS_MAX_CHARS=8000

# 1 = consulta robots.txt antes de navegar y respeta las prohibiciones.
# No lo desactives si no sabes lo que implica.
CAREER_OPS_RESPECT_ROBOTS=1

# Directorio donde se guardan las ofertas extraídas.
CAREER_OPS_JD_DIR=jds

# ── Renderizado de PDF (generate-pdf.mjs) ───────────────────────────────────

# Ruta a un Chromium/Chrome/Brave instalado, si el binario de Playwright no
# arranca en tu sistema. Requiere `npx playwright install chromium`.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

# 1 = detecta automáticamente Brave/Chrome/Edge/Chromium instalados.
CAREER_OPS_BROWSER_AUTODETECT=0

# ── Ubicación de los datos ──────────────────────────────────────────────────
#
# Solo si quieres separar tus datos (cv.md, profile.yml, jds/, output/) del
# código, por ejemplo para tener el repo intacto y tus datos en Dropbox.
#
# CAREER_OPS_ROOT=/ruta/a/mis-datos
# CAREER_OPS_PROFILE=/ruta/a/mis-datos/config/profile.yml
